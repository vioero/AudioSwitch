<Window x:Class="AudioSwitch.ClosePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioSwitch"
        Width="360" Height="230"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBg" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="MainText" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="SubText" Color="#666666"/>
        <SolidColorBrush x:Key="AccentBg" Color="#0067C0"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="关闭 AudioSwitch" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MainText}" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="1" Text="请选择：" FontSize="13" Foreground="{DynamicResource SubText}" Margin="0,0,0,12"/>
        <CheckBox Grid.Row="2" x:Name="RememberCheckBox" Content="记住我的选择，以后不再询问" FontSize="12" Foreground="{DynamicResource MainText}" Margin="0,0,0,16"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TrayButton" Content="最小化到托盘" Padding="14,8" FontSize="13" Margin="0,0,8,0" Click="TrayButton_Click"/>
            <Button x:Name="ExitButton" Content="完全退出" Padding="14,8" FontSize="13" Background="{DynamicResource AccentBg}" Foreground="White" Click="ExitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
