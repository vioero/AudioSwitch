<Window x:Class="AudioSwitch.ClosePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioSwitch"
        Width="360" Height="230"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgCanvas}"
        FontFamily="Segoe UI">
    <!-- 颜色/样式全部走 App 级主题字典，深浅色自动跟随，无需本地资源 -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="关闭 AudioSwitch" Style="{StaticResource TextTitle}" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="请选择关闭时的行为：" FontSize="13"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,14"/>
        <CheckBox Grid.Row="2" x:Name="RememberCheckBox" Content="记住我的选择，以后不再询问"
                  Style="{StaticResource ToggleStyle}" Margin="0,0,0,18"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TrayButton" Content="最小化到托盘"
                    Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,0"
                    Click="TrayButton_Click"/>
            <Button x:Name="ExitButton" Content="完全退出"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="ExitButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
