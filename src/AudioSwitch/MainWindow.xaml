<Window x:Class="AudioSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioSwitch"
        mc:Ignorable="d"
        Title="AudioSwitch"
        Icon="Assets/app.ico"
        Height="500" Width="460" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgCanvas}"
        FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei UI"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <!-- 保留系统原生窗口行为（拖拽、缩放、贴边吸附），只替换标题栏外观 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== 自定义标题栏 ==================== -->
        <Border Grid.Row="0" Background="Transparent" Padding="8,4"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="AudioSwitch" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinBtn" Content="&#xE921;" Click="MinBtn_Click"
                            Style="{StaticResource WindowButtonStyle}"/>
                    <Button x:Name="MaxBtn" Content="&#xE740;" Click="MaxBtn_Click"
                            Style="{StaticResource WindowButtonStyle}"/>
                    <Button x:Name="CloseBtn" Content="&#xE8BB;" Click="CloseBtn_Click"
                            Style="{StaticResource CloseCaptionButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主内容 ==================== -->
        <Grid Grid.Row="1" Margin="16,4,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 分段控制器：角色 + 该角色当前默认设备，两边现状一屏可见 -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="MicSegment" GroupName="AudioRole" IsChecked="True"
                             Style="{StaticResource RoleSegmentStyle}"
                             Checked="RoleSegment_Checked">
                    <StackPanel>
                        <TextBlock Text="麦克风" FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="MicSegmentDevice" Text="读取中…" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="SpeakerSegment" Grid.Column="2" GroupName="AudioRole"
                             Style="{StaticResource RoleSegmentStyle}"
                             Checked="RoleSegment_Checked">
                    <StackPanel>
                        <TextBlock Text="音箱" FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="SpeakerSegmentDevice" Text="读取中…" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                </RadioButton>
            </Grid>

            <!-- 列表头：当前角色 + 设备数 -->
            <Grid Grid.Row="1" Margin="4,0,4,8">
                <TextBlock x:Name="ListHeaderText" Text="选择默认麦克风" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                <TextBlock x:Name="DeviceCountText" Text="" FontSize="12"
                           Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- 设备列表（单列，点击即切换） -->
            <ListBox Grid.Row="2" x:Name="DeviceList"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemTemplate="{StaticResource DeviceRowTemplate}"
                     ItemContainerStyle="{StaticResource DeviceListItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="DeviceList_SelectionChanged"/>

            <!-- 空状态 -->
            <StackPanel Grid.Row="2" x:Name="EmptyState"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <Border Width="56" Height="56" CornerRadius="28"
                        Background="{DynamicResource BgSurfaceHover}" HorizontalAlignment="Center">
                    <TextBlock x:Name="EmptyStateIcon" Text="&#xE720;" FontFamily="Segoe Fluent Icons"
                               FontSize="24" Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="EmptyStateTitle" Text="没有检测到麦克风" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="EmptyStateDesc" Text="插入设备后会自动出现在这里"
                           FontSize="12" Foreground="{DynamicResource TextSecondary}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="300" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 底栏：开机自启动开关 + 设置入口 -->
            <Grid Grid.Row="3" Margin="4,12,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" x:Name="AutoStartCheckBox"
                          Content="开机自动启动"
                          Style="{StaticResource ToggleStyle}"
                          VerticalAlignment="Center"
                          Checked="AutoStartCheckBox_Changed"
                          Unchecked="AutoStartCheckBox_Changed"/>
                <Button Grid.Column="1" x:Name="SettingsBtn"
                        Style="{StaticResource OutlineButtonStyle}"
                        Click="SettingsBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="设置" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ==================== 半透明遮罩（抽屉打开时覆盖主内容） ==================== -->
        <Border x:Name="Overlay"
                Grid.Row="1"
                Background="#66000000"
                Visibility="Collapsed"
                MouseLeftButtonDown="Overlay_MouseLeftButtonDown"/>

        <!-- ==================== 右侧设置抽屉（340px，初始在屏幕外） ==================== -->
        <Border x:Name="SettingsPanel"
                Grid.Row="1"
                Width="340"
                HorizontalAlignment="Right"
                Background="{DynamicResource BgCanvas}"
                Visibility="Collapsed"
                RenderTransformOrigin="0,0">
            <Border.RenderTransform>
                <TranslateTransform X="340"/>  <!-- 与 SettingsPanelManager.DrawerWidth 保持一致 -->
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="-4" Opacity="0.15" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 抽屉标题 -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="设置" Style="{StaticResource TextDisplay}" VerticalAlignment="Center"/>
                    <Button x:Name="CloseSettingsBtn"
                            HorizontalAlignment="Right"
                            Click="CloseSettingsBtn_Click"
                            Style="{StaticResource WindowButtonStyle}">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="14"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Button>
                </Grid>

                <!-- 抽屉内容（可滚动） -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <StackPanel>

                        <!-- ========== 切换快捷键（高频，置顶；一行内联显示） ========== -->
                        <TextBlock Text="切换快捷键" Style="{StaticResource TextCaption}" Margin="4,0,0,8"/>
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="麦克风" FontSize="13"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Style="{StaticResource HotkeyCapsuleStyle}">
                                        <TextBlock x:Name="MicHotkeyBox" Text="Ctrl + Alt + F9" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <Button Grid.Column="2" x:Name="MicHotkeyBtn" Content="修改" FontSize="12"
                                            Padding="10,5" Style="{StaticResource OutlineButtonStyle}"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="音箱" FontSize="13"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Style="{StaticResource HotkeyCapsuleStyle}">
                                        <TextBlock x:Name="SpeakerHotkeyBox" Text="Ctrl + Alt + F10" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <Button Grid.Column="2" x:Name="SpeakerHotkeyBtn" Content="修改" FontSize="12"
                                            Padding="10,5" Style="{StaticResource OutlineButtonStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ========== 外观主题 ========== -->
                        <TextBlock Text="外观主题" Style="{StaticResource TextCaption}" Margin="4,0,0,8"/>
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <RadioButton x:Name="ThemeSystemRadio" GroupName="ThemeMode"
                                             Style="{StaticResource OptionCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="跟随系统" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="随 Windows 深浅色自动切换" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ThemeLightRadio" GroupName="ThemeMode"
                                             Style="{StaticResource OptionCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="浅色" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="始终使用浅色界面" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ThemeDarkRadio" GroupName="ThemeMode"
                                             Style="{StaticResource OptionCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="深色" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="始终使用深色界面" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!-- ========== 设备显示范围 ========== -->
                        <TextBlock Text="设备显示范围" Style="{StaticResource TextCaption}" Margin="4,0,0,8"/>
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <RadioButton x:Name="DisplaySmartRadio" GroupName="DisplayMode"
                                             Style="{StaticResource OptionCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="智能模式" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="隐藏混音回环、显卡 HDMI 等系统杂项" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="DisplayAllRadio" GroupName="DisplayMode"
                                             Style="{StaticResource OptionCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="显示全部设备" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="列出所有音频端点，包括虚拟声卡" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="DisplayUsbBtRadio" GroupName="DisplayMode"
                                             Style="{StaticResource OptionCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="仅 USB 与蓝牙" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="只显示外接设备" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!-- ========== 关闭按钮行为 ========== -->
                        <TextBlock Text="关闭按钮行为" Style="{StaticResource TextCaption}" Margin="4,0,0,8"/>
                        <Border Style="{StaticResource GroupCardStyle}">
                            <StackPanel>
                                <RadioButton x:Name="CloseAskRadio" GroupName="CloseBehavior"
                                             Style="{StaticResource OptionCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="每次询问" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="点关闭按钮时弹出选择框" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="CloseTrayRadio" GroupName="CloseBehavior"
                                             Style="{StaticResource OptionCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="最小化到托盘" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="隐藏到托盘继续运行" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="CloseExitRadio" GroupName="CloseBehavior"
                                             Style="{StaticResource OptionCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="完全退出" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="关闭即结束程序" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 抽屉底部按钮 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="ResetBtn" Content="恢复默认" Style="{StaticResource OutlineButtonStyle}"
                            FontSize="12" Margin="0,0,8,0"/>
                    <Button x:Name="SaveBtn" Content="保存" Style="{StaticResource PrimaryButtonStyle}" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
