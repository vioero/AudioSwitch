<!--
  浅色主题令牌（对应 UI设计方案.md 4.1）。
  全部颜色必须走这里，控件样式只允许 DynamicResource 引用，不允许硬编码。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 背景 -->
    <SolidColorBrush x:Key="BgCanvas" Color="#F6F7F9"/>
    <SolidColorBrush x:Key="BgSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgSurfaceHover" Color="#F1F3F5"/>
    <SolidColorBrush x:Key="BgAccentSubtle" Color="#E8F1FB"/>
    <SolidColorBrush x:Key="BgAccentSubtleStrong" Color="#D6E8F9"/>

    <!-- 边框 -->
    <SolidColorBrush x:Key="BorderHairline" Color="#E3E6EA"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#D8DCE1"/>
    <SolidColorBrush x:Key="BorderAccent" Color="#9CC6EE"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#1A1D21"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#9AA1AA"/>

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentDefault" Color="#0A66B8"/>
    <SolidColorBrush x:Key="AccentHover" Color="#085A9E"/>
    <SolidColorBrush x:Key="AccentText" Color="#0A66B8"/>

    <!-- 状态色 -->
    <SolidColorBrush x:Key="StatusOnline" Color="#0F7B3D"/>
    <SolidColorBrush x:Key="StatusDanger" Color="#A32D2D"/>

    <!-- 控件专用 -->
    <SolidColorBrush x:Key="ToggleTrackOff" Color="#CBD1D8"/>
    <SolidColorBrush x:Key="ToggleThumb" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RadioRing" Color="#5F6670"/>

</ResourceDictionary>
