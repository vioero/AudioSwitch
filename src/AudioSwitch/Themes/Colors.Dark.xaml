<!--
  深色主题令牌（对应 UI设计方案.md 4.2）。
  与 Colors.Light.xaml 的键名一一对应，ThemeService 整体切换字典实现换肤。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 背景 -->
    <SolidColorBrush x:Key="BgCanvas" Color="#1C1F24"/>
    <SolidColorBrush x:Key="BgSurface" Color="#24272C"/>
    <SolidColorBrush x:Key="BgSurfaceHover" Color="#2C3036"/>
    <SolidColorBrush x:Key="BgAccentSubtle" Color="#1E3A52"/>
    <SolidColorBrush x:Key="BgAccentSubtleStrong" Color="#25496F"/>

    <!-- 边框 -->
    <SolidColorBrush x:Key="BorderHairline" Color="#33373D"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#363A40"/>
    <SolidColorBrush x:Key="BorderAccent" Color="#3D6E96"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F2F3F5"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#A0A6AD"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#6E747C"/>

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentDefault" Color="#2E7BC4"/>
    <SolidColorBrush x:Key="AccentHover" Color="#3586CE"/>
    <SolidColorBrush x:Key="AccentText" Color="#6FB4E8"/>

    <!-- 状态色 -->
    <SolidColorBrush x:Key="StatusOnline" Color="#4CC38A"/>
    <SolidColorBrush x:Key="StatusDanger" Color="#F09595"/>

    <!-- 控件专用 -->
    <SolidColorBrush x:Key="ToggleTrackOff" Color="#3D4249"/>
    <SolidColorBrush x:Key="ToggleThumb" Color="#F2F3F5"/>
    <SolidColorBrush x:Key="RadioRing" Color="#8A9099"/>

</ResourceDictionary>
