<!--
  组件样式（对应 UI设计方案.md 第 5 章组件规格）。
  规则：颜色一律 DynamicResource 引用 Themes/Colors.*.xaml 的令牌，禁止硬编码；
  字号字重引用 Themes/Typography.xaml（需在 App.xaml 中先于本字典合并）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== 键盘焦点环 ==================== -->
    <!-- 仅键盘导航时显示（鼠标点击不出现），2px 强调色圆角框，offset 约 3px。
         画在 Adorner 层，不占布局、不随主题硬编码。 -->
    <Style x:Key="RingFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="9" Margin="-3" Background="Transparent"
                            BorderBrush="{DynamicResource AccentDefault}" BorderThickness="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 滚动条：细条、圆角、hover 加深 ==================== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Width="{TemplateBinding Width}" Background="#06000000" CornerRadius="3" Padding="2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder" CornerRadius="3"
                                                    Background="{DynamicResource TextTertiary}"/>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Thumb}" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background"
                                                            Value="{DynamicResource TextSecondary}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Height" Value="6"/>
                            <Setter Property="MinHeight" Value="6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 设备行（52px，默认/在线/离线三态，三重编码） ==================== -->
    <Style x:Key="DeviceListItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RingFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" CornerRadius="10" Padding="12,9" SnapsToDevicePixels="True"
                            Background="{DynamicResource BgSurface}"
                            BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1">
                        <Grid>
                            <!-- hover 层：背景色由 IsDefault 触发器决定，透明度由 IsMouseOver 动画驱动 -->
                            <Border x:Name="HoverLayer" CornerRadius="9" Opacity="0"
                                    Background="{DynamicResource BgSurfaceHover}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 默认设备：填充 + 边框 + 徽章三重编码的第一、二重 -->
                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource BgAccentSubtle}"/>
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
                            <Setter TargetName="HoverLayer" Property="Background" Value="{DynamicResource BgAccentSubtleStrong}"/>
                        </DataTrigger>
                        <!-- 离线：整体降透明度（文字标签「已断开」在 ItemTemplate 中） -->
                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.6"/>
                        </DataTrigger>
                        <!-- hover：120ms 背景淡入 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 键盘焦点指示由 RingFocusVisual（Adorner 层焦点环）统一负责 -->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 设备行内容模板 ==================== -->
    <DataTemplate x:Key="DeviceRowTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 32px 圆角图标底：默认态用 Surface 底 + AccentText 图标 -->
            <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource BgSurfaceHover}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- 文字区：名称单行省略，副标题保留总线类型 -->
            <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{StaticResource TextBody}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TextMeta}" Margin="0,1,0,0"/>
            </StackPanel>

            <!-- 尾部标记：默认徽章 / 在线圆点 / 已断开标签，三选一 -->
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Border x:Name="DefaultBadge" CornerRadius="6" Padding="6,2" Visibility="Collapsed"
                        Background="{DynamicResource BgSurface}"
                        BorderBrush="{DynamicResource BorderAccent}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                   Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"/>
                        <TextBlock Text="默认" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="3,0,0,0"/>
                    </StackPanel>
                </Border>
                <Ellipse x:Name="OnlineDot" Width="7" Height="7" Visibility="Collapsed"
                         Fill="{DynamicResource StatusOnline}" HorizontalAlignment="Right"/>
                <Border x:Name="OfflineLabel" CornerRadius="6" Padding="6,2" Visibility="Collapsed"
                        Background="{DynamicResource BgSurfaceHover}">
                    <TextBlock Text="已断开" FontSize="11" Foreground="{DynamicResource TextTertiary}"/>
                </Border>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <!-- 默认：徽章（第三重编码） -->
            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                <Setter TargetName="DefaultBadge" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <!-- 非默认且在线：7px 状态圆点 -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsDefault}" Value="False"/>
                    <Condition Binding="{Binding IsConnected}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="OnlineDot" Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
            <!-- 离线：文字标签，不只靠变灰 -->
            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                <Setter TargetName="OfflineLabel" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ==================== 托盘菜单：紧凑设备行（34px） ==================== -->
    <!-- 与主界面设备行同语义（默认/在线/离线），但按菜单密度压缩：无副标题、对勾在左 -->
    <Style x:Key="TrayRowStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RingFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" CornerRadius="6" Padding="9,0" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 默认设备：浅 accent 底 + 对勾（内容模板中） -->
                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource BgAccentSubtle}"/>
                        </DataTrigger>
                        <!-- 离线：禁用 + 降透明度（不可点、不参与 Tab / 方向键） -->
                        <DataTrigger Binding="{Binding IsConnected}" Value="False">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter TargetName="Row" Property="Opacity" Value="0.55"/>
                        </DataTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsEnabled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource BgSurfaceHover}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="TrayRowTemplate">
        <Grid Height="34">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- 默认设备对勾 -->
            <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="13"
                       Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource TextBodyRegular}"
                       Margin="7,0,0,0" VerticalAlignment="Center"/>
            <!-- 离线文字标签，不只靠变灰 -->
            <TextBlock x:Name="Offline" Grid.Column="2" Text="已断开" FontSize="11"
                       Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center"
                       Margin="10,0,0,0" Visibility="Collapsed"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                <Setter TargetName="Offline" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ==================== 托盘菜单：底部动作行（34px） ==================== -->
    <Style x:Key="TrayActionStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RingFocusVisual}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="6" Padding="9,0" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgSurfaceHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 分段控制器段（56px，显示角色 + 当前默认设备） ==================== -->
    <Style x:Key="RoleSegmentStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RingFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Seg" CornerRadius="10" Padding="12,8" MinHeight="56"
                            Background="{DynamicResource BgSurface}"
                            BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Seg" Property="Background" Value="{DynamicResource BgAccentSubtle}"/>
                            <Setter TargetName="Seg" Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Seg" Property="Background" Value="{DynamicResource BgSurfaceHover}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Seg" Property="Background" Value="{DynamicResource BgAccentSubtleStrong}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 卡片式单选（44px 最小高度，整行可点） ==================== -->
    <Style x:Key="OptionCardStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RingFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Card" CornerRadius="9" Padding="12,10" MinHeight="44"
                            Background="{DynamicResource BgSurface}"
                            BorderBrush="{DynamicResource BorderHairline}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 17px 圆环：选中时描边转强调色并显示内部实心点 -->
                            <Grid Width="17" Height="17" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Stroke="{DynamicResource RadioRing}" StrokeThickness="1.5"/>
                                <Ellipse x:Name="Dot" Width="11" Height="11" Visibility="Collapsed"
                                         Fill="{DynamicResource AccentText}"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource BgAccentSubtle}"/>
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentText}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource BgSurfaceHover}"/>
                        </MultiTrigger>
                        <!-- 键盘焦点指示由 RingFocusVisual（Adorner 层焦点环）统一负责 -->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 开关（38 × 21，滑块 16px） ==================== -->
    <Style x:Key="ToggleStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RingFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="38" Height="21" CornerRadius="10.5" VerticalAlignment="Center"
                                Background="{DynamicResource ToggleTrackOff}">
                            <Ellipse x:Name="Thumb" Width="16" Height="16"
                                     Fill="{DynamicResource ToggleThumb}"
                                     HorizontalAlignment="Left" Margin="2.5,0,0,0"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentDefault}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2.5,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 主按钮 ==================== -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentDefault}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RingFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" BorderThickness="0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 次要按钮（边框） ==================== -->
    <Style x:Key="OutlineButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RingFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgSurfaceHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 标题栏图标按钮（最小化 / 最大化 / 关闭抽屉） ==================== -->
    <Style x:Key="WindowButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RingFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgSurfaceHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 设置分组卡片（抽屉内每组设置的容器） ==================== -->
    <Style x:Key="GroupCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHairline}"/>
    </Style>

    <!-- ==================== 快捷键胶囊（HotkeyRow 的键位显示） ==================== -->
    <Style x:Key="HotkeyCapsuleStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceHover}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ==================== 标题栏关闭按钮（hover 红色） ==================== -->
    <Style x:Key="CloseCaptionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource RingFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#C42B1C"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
